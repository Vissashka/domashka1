venv/*              # Исключаем папку виртуального окружения
*.pyc               # Исключение файлов Python байт-кода
__pycache__/        # Папка с кэшированными файлами компилятора
.DS_Store           # Скрытые файлы macOS
.idea/              # IDEA-проект PyCharm
*.log               # Лог-файлы
*.swp               # Временные файлы vim
.idea